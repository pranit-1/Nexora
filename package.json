    "lucide-react": "^0.523.0",
    "mammoth": "^1.8.0",
    "next": "16.2.10",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^4.7.76",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.57.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
